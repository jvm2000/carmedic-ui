<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /carmedic/

  # Allow existing files and directories (icons, assets, images, css, js, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Bypass Vite assets
  RewriteRule ^assets/ - [L]

  # Bypass icons folder
  RewriteRule ^icons/ - [L]

  # For Single Page Application, redirect all other routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
